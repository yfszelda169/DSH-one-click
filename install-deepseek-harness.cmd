@echo off
setlocal EnableExtensions
title DeepSeek Harness Installer

set "DSH_B64=%TEMP%\deepseek-harness-install-%RANDOM%-%RANDOM%.b64"
set "DSH_PS1=%TEMP%\deepseek-harness-install-%RANDOM%-%RANDOM%.ps1"

echo Preparing installer...
more +36 "%~f0" > "%DSH_B64%"
if errorlevel 1 goto :prepare_failed
certutil.exe -decode "%DSH_B64%" "%DSH_PS1%" >nul
if errorlevel 1 goto :prepare_failed
del /f /q "%DSH_B64%" >nul 2>&1

powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File "%DSH_PS1%" %*
set "EXIT_CODE=%ERRORLEVEL%"
del /f /q "%DSH_PS1%" >nul 2>&1

echo.
if "%EXIT_CODE%"=="0" (
  echo Deployment completed.
) else (
  echo Deployment incomplete. Exit code: %EXIT_CODE%
  echo See the log shown above.
)
echo.
pause
exit /b %EXIT_CODE%

:prepare_failed
echo Failed to prepare the installer.
pause
exit /b 2

goto :eof

